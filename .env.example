# =============================================================================
# spark-sovereign — environment variables
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_TOKEN=your_hf_token_here
HF_HUB_ENABLE_HF_TRANSFER=1

# ── Brain (vLLM) ──────────────────────────────────────────────────────────────
# Bearer token required on every /v1 request. Leave BLANK for no auth.
# Generate one:  openssl rand -hex 32
# No spaces — the `serve` entrypoint branch word-splits VLLM_EXTRA_ARGS.
# After setting this, add the same key to OpenClaw's provider config, or it
# will fail to reach the brain.
BRAIN_API_KEY=

# ── SearXNG ───────────────────────────────────────────────────────────────────
# Leave blank to auto-generate on first run (set explicitly for stable restarts)
SEARXNG_SECRET_KEY=

# ── Telegram (optional) ───────────────────────────────────────────────────────
# Get bot token: message @BotFather on Telegram
# Get your user ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ── Slack (optional) ──────────────────────────────────────────────────────────
# Create app at api.slack.com — needs bot token (xoxb-) and app token (xapp-)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=

# ── GitHub MCP ────────────────────────────────────────────────────────────────
# Personal access token with repo + workflow scopes
GITHUB_PAT=

# ── AWS MCP ───────────────────────────────────────────────────────────────────
AWS_PROFILE=default

# ── Stripe MCP ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Notion MCP (optional) ─────────────────────────────────────────────────────
NOTION_API_TOKEN=

# ── Linear MCP (optional) ─────────────────────────────────────────────────────
LINEAR_API_KEY=

# ── Model paths (override defaults from config/models.yml) ───────────────────
MODELS_DIR=/opt/models
